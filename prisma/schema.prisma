generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  pending
  in_review
  reviewed
  needs_revision
  allow_approve
  approved
  cancelled
}

enum ReviewEventType {
  review_result
  approved
  status_note
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  tasks        Task[]
  comments     TaskComment[]
  apiKeys      ApiKey[]
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String
  keyPrefix   String
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
}

model Task {
  id           String         @id @default(cuid())
  title        String
  description  String?
  mrUrl        String
  mrIid        String?
  projectId    String?
  status       TaskStatus     @default(pending)
  allowApprove Boolean        @default(false)
  skipReview   Boolean        @default(false)
  createdById  String
  createdBy    User           @relation(fields: [createdById], references: [id])
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  comments     TaskComment[]
  events       ReviewEvent[]
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model ReviewEvent {
  id        String          @id @default(cuid())
  taskId    String
  task      Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type      ReviewEventType
  payload   String
  createdAt DateTime        @default(now())
}
